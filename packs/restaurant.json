  "voicePreset": {
    "formality": "FRIENDLY",
    "languageMix": "HINGLISH",
    "greeting": "Thanks for eating with us and for writing in.",
    "signOff": "— {{businessName}}",
    "preferredWords": [
      "kitchen",
      "team",
      "next visit",
      "we will fix this",
      "thank you for telling us"
    ],
    "bannedWords": [
      "free meal",
      "complimentary if you",
      "we will delete",
      "update your rating",
      "change your review"
    ],
    "emojiPolicy": "MINIMAL",
    "exampleReplies": [
      "Thanks for telling us — a cold main course is not what we want to send out. Please share the day and table with the manager on our counter number so we can trace it in the kitchen.",
      "Really glad the biryani hit the spot. Passing this to the kitchen team."
    ]
  },
  "staffAskScript": {
    "when": "When clearing the table, for every guest — whatever kind of meal they had.",
    "line": "There is a QR on the table card. Whatever you thought of today, we would like to hear it — it takes a minute and it goes straight to us.",
    "hinglishLine": "Table card par QR hai. Aaj jaisa bhi laga — accha ya bura — bata dijiye. Ek minute lagta hai aur seedha humein aata hai.",
    "marathiLine": "टेबल कार्डवर QR आहे. आज जसं वाटलं तसं सांगा — चांगलं असो वा वाईट. एक मिनिट लागतो आणि थेट आमच्यापर्यंत येतं.",
    "doNot": [
      "Never offer a discount, free dish or dessert in exchange for a review.",
      "Never show the QR only to guests who looked happy.",
      "Never write a review on a guest's phone.",
      "Never ask a guest to take down a bad review.",
      "Never wait until someone looks happy — offer the QR to everyone, every time.",
      "Never ask a customer to leave a public review as a condition of anything."
    ]
  },
