# =============================================================================
# RepOS - environment template
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and MUST never be committed.
#
# Nothing in this file is exposed to the browser. RepOS deliberately defines
# ZERO `NEXT_PUBLIC_*` variables — any variable prefixed with NEXT_PUBLIC_ would
# be inlined into client bundles, so we never put a key behind that prefix.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (local SQLite file — no external database, ever)
# -----------------------------------------------------------------------------
# Path is resolved relative to the `prisma/` directory.
DATABASE_URL="file:../data/repos.db"

# -----------------------------------------------------------------------------
# AI providers (OPTIONAL)
# -----------------------------------------------------------------------------
# RepOS works fully without any AI key. With no key configured the app runs in
# deterministic-only mode: reviews are tagged by the local keyword classifier
# and all report prose falls back to templates. AI never computes numbers.
#
# V1 registers exactly ONE provider: Groq.
# Google-operated endpoints are prohibited by the V1 hard rules, so there is no
# Gemini / AI Studio provider in this build. An unknown value here is ignored,
# never guessed at, and never contacted. See COMPLIANCE.md.
# Allowed values: groq
REPOS_AI_PRIMARY="groq"

# Groq (https://console.groq.com) — free tier, plain API key, no OAuth.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Hard timeout (ms) for any single AI call.
REPOS_AI_TIMEOUT_MS="45000"

# Set to "1" to hard-disable all outbound AI calls (fully offline mode).
REPOS_AI_DISABLED="0"

# -----------------------------------------------------------------------------
# Local PDF / PNG rendering (Playwright, Chromium-based)
# -----------------------------------------------------------------------------
# RepOS renders print assets locally with playwright-core driving a Chromium
# browser that is ALREADY on this machine. Nothing is uploaded anywhere.
#
# Leave blank to auto-detect (Playwright cache -> Chrome -> Edge -> Chromium).
# Set explicitly if auto-detection fails, e.g.
#   REPOS_BROWSER_EXECUTABLE="C:\Program Files\Google\Chrome\Application\chrome.exe"
REPOS_BROWSER_EXECUTABLE=""

# -----------------------------------------------------------------------------
# Operator / agency identity (shown on generated reports and kits)
# -----------------------------------------------------------------------------
REPOS_AGENCY_NAME="RepOS"
REPOS_OPERATOR_NAME=""
