# =============================================================================
# RepOS - environment template
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and MUST never be committed.
#
# Nothing in this file is exposed to the browser. RepOS deliberately defines
# ZERO `NEXT_PUBLIC_*` variables — any variable prefixed with NEXT_PUBLIC_ would
# be inlined into client bundles, so we never put a key behind that prefix.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (local SQLite file — no external database, ever)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# AI providers (OPTIONAL)
# -----------------------------------------------------------------------------
# RepOS works fully without any AI key. With no key configured the app runs in
# deterministic-only mode: reviews are tagged by the local keyword classifier
# and all report prose falls back to templates. AI never computes numbers.
#
# V1 registers exactly ONE provider: Groq.
# Google-operated endpoints are prohibited by the V1 hard rules, so there is no
# Gemini / AI Studio provider in this build. An unknown value here is ignored,
# never guessed at, and never contacted. See COMPLIANCE.md.
# Allowed values: groq
REPOS_AI_PRIMARY="groq"

# Groq (https://console.groq.com) — free tier, plain API key, no OAuth.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Hard timeout (ms) for any single AI call.
REPOS_AI_TIMEOUT_MS="45000"

# Set to "1" to hard-disable all outbound AI calls (fully offline mode).
REPOS_AI_DISABLED="0"


# -----------------------------------------------------------------------------
# Operator / agency identity (shown on generated reports and kits)
# -----------------------------------------------------------------------------
REPOS_AGENCY_NAME="RepOS"
REPOS_OPERATOR_NAME=""
# -----------------------------------------------------------------------------
# The address customers open (M16) — REQUIRED in production
# -----------------------------------------------------------------------------
# Every QR code, printed card and owner link is built from this one address.
# It must not change when RepOS restarts, or printed cards stop working.
#
# In production this MUST be set and MUST be https. RepOS refuses to guess it
# from a request header, because a header can be forged by anyone who can
# reach the server — and a forged address ends up permanently inside a QR.
#
# Leave it blank in development: RepOS then uses the address you opened it on,
# or the one saved on a client’s Feedback QR page.
#   REPOS_PUBLIC_BASE_URL="https://repos.example.com"
REPOS_PUBLIC_BASE_URL=""

# -----------------------------------------------------------------------------
# Signing in (M16) — REQUIRED
# -----------------------------------------------------------------------------
# RepOS has exactly one operator: you. Both values below are produced by
#   npm run set-password
# which prints them, or writes them here itself with `-- --write`.
#
# The password is stored as a scrypt hash and lives ONLY in this file. It is
# never written to the database, so it is never inside a backup.
#
# The hash uses colons between its parts, never dollar signs: this file is read
# by a loader that expands `$NAME` inside a value, so a dollar sign would
# silently swallow the rest of the line and lock you out.

# Signs the session cookie. At least 32 characters of randomness. Changing it
# signs out every open session immediately, which is the fastest way to lock
# RepOS if a laptop goes missing.

# -----------------------------------------------------------------------------
# Backups (M16)
# -----------------------------------------------------------------------------
# Where "Take a backup now" writes its copies. Defaults to ./backups, beside
# the installation and outside the folder holding the live database.
# Point it at another drive if you have one. Nothing is ever uploaded.
REPOS_BACKUP_DIR=""

# -----------------------------------------------------------------------------
# Database (M20: PostgreSQL / Supabase — SQLite through M19)
# -----------------------------------------------------------------------------
# There is deliberately no default. A wrong guess used to mean a migration
# command aimed itself at whatever file sat at the old relative path.
#
# DATABASE_URL        the pooled connection the application uses
# DIRECT_DATABASE_URL bypasses the pooler; migrations need it on Supabase
DATABASE_URL="postgresql://user:password@host:5432/repos?schema=public"
DIRECT_DATABASE_URL="postgresql://user:password@host:5432/repos?schema=public"

# -----------------------------------------------------------------------------
# Supabase Auth (M20) — the single canonical identity system
# -----------------------------------------------------------------------------
# RepOS stores no password, no hash and no reset token. Supabase Auth verifies
# every sign-in; RepOS holds the User row, the link to that identity, and the
# memberships that decide what the person may reach.
#
# These are NOT prefixed NEXT_PUBLIC_. RepOS has never defined a NEXT_PUBLIC_
# variable and does not start now: authentication runs entirely in server
# actions, so no project URL, key or SDK is ever shipped to a browser.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY=""

# The service-role key bypasses Row Level Security completely. RepOS does not
# read it anywhere, and it must never be added to this file or to Vercel unless
# a future server-only job genuinely needs it.
# SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# First administrator (M20)
# -----------------------------------------------------------------------------
# Platform admin cannot be granted from a browser, a signup or an invitation.
# scripts/bootstrap-admin.mjs is the only path, and it demands this secret in
# the environment AND as --secret. Set it, run the script once against an
# account that has already signed up, then rotate or remove it.
REPOS_BOOTSTRAP_SECRET=""

# -----------------------------------------------------------------------------
# Test database (M20)
# -----------------------------------------------------------------------------
# The test suite has no default connection string, on purpose: a working
# default would mean a password in tracked source. Point this at a LOCAL,
# DISPOSABLE PostgreSQL database and nothing else — the suite creates and
# drops a schema per test file and truncates tables between cases. It refuses
# any host that is not localhost.
#
# This belongs in your shell or .env.local, never in a committed file.
REPOS_TEST_DATABASE_URL=""
