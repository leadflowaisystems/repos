node_modules/
.next/
out/
build/
dist/

# Never commit a database. The narrow data/ rules came first; the blanket
# rule below is the one that matters — a stray copy anywhere in the tree is
# real customer data and must not reach a remote by accident.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/uploads/
data/exports/
# Local machine state from the demo seeder, tied to one local database.
data/.demo-manifest.json

# Database backups. Real client data — never committed, never uploaded.
backups/

# Secrets. Everything except the committed template.
#
# `.env*` rather than `.env.*`: the dotted form only matches when a literal dot
# follows, so `.envrc`, `.env_local` and `.env~` would all have slipped through.
.env
.env*
!.env.example
.env.local.previous

# Editor, merge and rebase artifacts.
#
# These matter more than they look. A conflicted merge, a `git stash pop` or a
# `git apply --reject` writes a copy of the ORIGINAL file next to it — and for
# any file whose committed version carries a credential, that copy carries the
# credential too, into a path nothing was ignoring.
*.orig
*.rej
*.bak
*.save
*.swp
*~

# Database dumps. `pg_dumpall --globals-only` writes every role's password
# verifier; a dump left in the working tree is stageable like any other file.
dump.sql
globals.sql
roles.sql
pg_dumpall.out
*.dump
*.pem
*.key
secrets/
credentials.json
service-account*.json

# OS / editor
.DS_Store
Thumbs.db
*.log
npm-debug.log*
.vscode/
.idea/

# Test / tooling caches
coverage/
.vitest/
*.tsbuildinfo

# Test databases
data/.test/

# Deployment / tooling
.vercel/
supabase/.temp/
supabase/.branches/

.vercel
.env*.local
